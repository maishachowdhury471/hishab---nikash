# Copy to .env for local dev. On Railway, set these as Variables instead.
# Local dev (SQLite file): leave DATABASE_URL empty or use the sqlite line.
# Railway: set DATABASE_URL to the Postgres URL from the Railway Postgres service
# (Railway usually injects it automatically when the database is linked).
DATABASE_URL=
# DATABASE_URL=sqlite:///./hisab.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/railway
PORT=8000

# --- Daily reminder notifications (Web Push) ---
# Generate a key pair once:  python scripts/gen_vapid_keys.py
# Then paste the two values here / as Railway Variables. Without them the
# app still runs fine — server push is simply disabled and only the
# in-app + catch-up reminders work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who the push service may contact about problems (any mailto: address).
VAPID_SUBJECT=mailto:admin@example.com
# Shared secret for the daily cron trigger (POST /api/reminders/trigger).
# Pick a long random value and use the SAME value in the cron-job.org header.
# Without it, /api/reminders/trigger answers 503 and no push is ever sent.
REMINDER_SECRET=

# --- Login tokens (JWT — Google-only login) ---
# Secret used to sign login tokens (JWT). Pick one LONG random value and
# set it as a Railway Variable. If it is NOT set, the app still runs but
# generates a random secret on every boot — then every user is logged out
# on every restart/redeploy. Never commit a real secret to Git.
JWT_SECRET=

# --- Google দিয়ে লগইন (Sign in with Google) ---
# 1. Google Cloud Console (console.cloud.google.com) -> নতুন প্রোজেক্ট ->
#    APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
#    -> Web application. Authorized JavaScript origins-এ বসান:
#    https://hishab-nikash-production.up.railway.app
#    (লোকাল পরীক্ষার জন্য http://localhost:8000 ও যোগ করা যায়।)
# 2. যে Client ID দেবে, সেটা Railway-তে GOOGLE_CLIENT_ID নামে বসান।
# ছাড়া অ্যাপ চলবে — Google বোতামটি লুকিয়ে যাবে আর
# /api/auth/google 503 দেবে; ইউজারনেম+পাসওয়ার্ড লগইন আগের মতোই চলবে।
GOOGLE_CLIENT_ID=
