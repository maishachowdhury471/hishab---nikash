# Copy to .env for local dev. On Railway, set these as Variables instead.
# Local dev (SQLite file): leave DATABASE_URL empty or use the sqlite line.
# Railway: set DATABASE_URL to the Postgres URL from the Railway Postgres service
# (Railway usually injects it automatically when the database is linked).
DATABASE_URL=
# DATABASE_URL=sqlite:///./hisab.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/railway
PORT=8000
